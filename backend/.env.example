# PostgreSQL connection (Supabase or any Postgres instance).
# Use the "Connection string" from Supabase Project Settings -> Database.
# Example: postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/otp_desk
# Supabase's pooled connections require SSL; set to "true" when connecting to Supabase.
DATABASE_SSL=true

# 32-byte key (base64) used to encrypt TOTP secrets at rest with AES-256-GCM.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Port the backend HTTP server listens on.
PORT=4000

# Origin of the frontend, used for CORS and cookie settings.
FRONTEND_ORIGIN=http://localhost:3000

# Set to "true" when serving the backend over HTTPS in production
# (controls the Secure flag on the session cookie).
COOKIE_SECURE=false
